# ============================================================================
# PI Advisor MCP — ADN edition — configuration template
# Copy to .env and fill in. Lock the file down (see README §5).
# All relative paths resolve against this package directory.
# ============================================================================

# ---------------------------------------------------------------------------
# MCP server transport
#   stdio — local MCP client launches the server as a subprocess (dev only)
#   http  — streamable HTTP endpoint at /mcp (required for Copilot Studio)
# ---------------------------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8443
# TLS served directly by the process. Leave both empty if IIS/ARR or another
# reverse proxy terminates TLS in front (Copilot Studio requires HTTPS).
MCP_SSL_CERTFILE=
MCP_SSL_KEYFILE=

# ---------------------------------------------------------------------------
# Inbound authentication (who may call THIS MCP server)
#   none      — no auth; only for stdio testing. Refused with MCP_TRANSPORT=http.
#   api_key   — static key(s) in the X-API-Key header (day-one POC)
#   entra_jwt — validate Microsoft Entra ID bearer tokens + allowlist
# ---------------------------------------------------------------------------
AUTH_MODE=api_key

# api_key mode: one or more comma-separated keys (generate long random values)
AUTH_API_KEYS=

# entra_jwt mode:
AUTH_ENTRA_TENANT_ID=
# Expected token audience — api://<server-app-client-id> or the client id itself
AUTH_ENTRA_AUDIENCE=
# Override only if your issuer differs from
# https://login.microsoftonline.com/<tenant>/v2.0 (e.g. v1 tokens or a
# sovereign-cloud login endpoint)
AUTH_ENTRA_ISSUER=
# Signing keys — set exactly one:
#   file exported ahead of time (fully offline; refresh monthly), or a URL
#   reachable from inside the private network
AUTH_JWKS_FILE=auth\jwks.json
AUTH_JWKS_URL=

# Caller allowlist (comma-separated; case-insensitive). Empty = any valid
# tenant token (NOT recommended). Users match oid/upn/preferred_username/email;
# groups match Entra group object IDs in the token's groups claim;
# apps match appid/azp (e.g. the Copilot Studio connector app).
AUTH_ALLOWED_USERS=
AUTH_ALLOWED_GROUPS=
AUTH_ALLOWED_APPS=

# ---------------------------------------------------------------------------
# PI Web API connection (outbound)
# ---------------------------------------------------------------------------
PI_WEBAPI_URL=https://<pi-webapi-host>/piwebapi
AF_SERVER_NAME=<af-server-name>
AF_DATABASE_NAME=<af-database-name>
DATA_SERVER_NAME=<data-server-name>

# kerberos — Windows Integrated Security gateway (recommended; uses the
#            identity of the Windows service account this process runs as)
# oauth    — OAuth gateway, client-credentials grant
# bearer   — static token supplied out-of-band
# basic    — username/password (lab only)
PI_AUTH_METHOD=kerberos

# kerberos: usually nothing else needed. Override the SPN parts only if the
# gateway is registered under a different service/host than the URL hostname.
PI_KERBEROS_SERVICE=HTTP
PI_KERBEROS_HOSTNAME=
# Explicit domain credentials INSTEAD of the process identity (avoid if possible)
PI_KERBEROS_USERNAME=
PI_KERBEROS_PASSWORD=

# oauth (client credentials against the OAuth gateway):
PI_OAUTH_TOKEN_URL=
PI_OAUTH_CLIENT_ID=
PI_OAUTH_CLIENT_SECRET=
PI_OAUTH_SCOPE=
PI_OAUTH_RESOURCE=

# bearer:
PI_BEARER_TOKEN=

# basic:
PI_USERNAME=
PI_PASSWORD=

# TLS to PI Web API: point at the internal enterprise CA chain (PEM) instead
# of disabling verification.
PI_VERIFY_SSL=true
PI_CA_BUNDLE=
PI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Embedding model — MUST be the local pre-downloaded directory in the
# air-gapped deployment (offline mode is forced automatically for local paths)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=models\bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# ChromaDB / knowledge graph / BM25 / indexing / cache
# ---------------------------------------------------------------------------
CHROMA_CLIENT_TYPE=persistent
CHROMA_DATA_DIR=chroma_data
CHROMA_COLLECTION=af_elements

KG_ENABLED=true
KG_PERSIST_PATH=graph_data
KG_MAX_DEPTH=10

BM25_ENABLED=true
BM25_PERSIST_PATH=bm25_data

INDEXING_ENABLED=true
INDEXING_REFRESH_HOURS=24
INDEXING_BATCH_SIZE=50
INDEXING_MAX_ELEMENTS=10000
INDEXING_CONCURRENCY=20
# Optional subtree scoping, comma-separated AF paths, e.g.
# INDEX_ROOT_PATHS=\\AFSRV\ProdDB\Site 1,\\AFSRV\ProdDB\Site 2
INDEX_ROOT_PATHS=

CACHE_ENABLED=true
CACHE_MAX_SIZE=500
CACHE_CURRENT_VALUE_TTL=30
CACHE_SUMMARY_TTL=300
CACHE_HEALTH_TTL=60
CACHE_STRUCTURAL_TTL=600
CACHE_RESOLUTION_TTL=900
CACHE_FORECAST_TTL=3600

# ---------------------------------------------------------------------------
# Restricted calculation tool
# ---------------------------------------------------------------------------
CALC_TOOL_ENABLED=true
CALC_TOOL_TIMEOUT=10
CALC_TOOL_MAX_OUTPUT=50000

LOG_LEVEL=INFO
